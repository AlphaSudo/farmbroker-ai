# FarmBroker AI — env template (names only, no values).
# Copy to .env.local and fill locally. Same names go to Vercel.
# NEVER commit .env.local. NEVER show values in video/README/Devpost.

# PayPal Sandbox (payee = FarmBroker AI business sandbox account; suppliers NOT paid via PayPal in MVP)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Supabase (publishable in NEXT_PUBLIC_*, secret server-only)
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AI — OpenRouter, best free key available (primary inkling, fallback nemotron)
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_PRIMARY=thinkingmachines/inkling:free
AI_MODEL_SECONDARY=liquid/lfm-2.5-2.6b:free

# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hub ops (demo operations account key — server-checked, never NEXT_PUBLIC_)
HUB_KEY=

# PayPal merchant binding + webhooks (1.1/1.5)
PAYPAL_MERCHANT_EMAIL=
PAYPAL_WEBHOOK_ID=

# Scheduler/worker trigger (2.4) — server-checked, never NEXT_PUBLIC_
CRON_SECRET=
